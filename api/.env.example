# Copie para .env antes de rodar localmente:  cp .env.example .env
# Toda variavel aqui e' validada no boot. Se algo estiver ausente ou invalido,
# a aplicacao NAO sobe — falha rapido e com mensagem explicita.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Postgres. O host "localhost" vale para execucao local;
# dentro do docker-compose o host e' o nome do servico ("db").
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mov_financeira?schema=public

# Minimo de 32 caracteres, validado no boot.
# Gere um valor real com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-valor-por-um-segredo-forte-de-no-minimo-32-chars
JWT_EXPIRES_IN=1h

# Swagger em /swagger. Desligue em producao real se a API for publica.
SWAGGER_ENABLED=true

# Origens liberadas no CORS, separadas por virgula.
# Na arquitetura BFF o browser nunca chama a API direto, entao isto serve
# apenas para ferramentas de desenvolvimento. Vazio = nenhuma origem liberada.
CORS_ORIGINS=
